file path=usr/lib/$(MACH64)/ivl/vlog95.conf
file path=usr/lib/$(MACH64)/ivl/vlog95.tgt
file path=usr/lib/$(MACH64)/ivl/vpi_debug.vpi
file path=usr/lib/$(MACH64)/ivl/vvp-s.conf
file path=usr/lib/$(MACH64)/ivl/vvp.conf
file path=usr/lib/$(MACH64)/ivl/vvp.tgt
file path=usr/lib/$(MACH64)/libveriuser.a
