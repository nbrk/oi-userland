file path=usr/lib/$(MACH64)/ivl/null.conf
file path=usr/lib/$(MACH64)/ivl/null.tgt
file path=usr/lib/$(MACH64)/ivl/pcb-s.conf
file path=usr/lib/$(MACH64)/ivl/pcb.conf
file path=usr/lib/$(MACH64)/ivl/pcb.tgt
file path=usr/lib/$(MACH64)/ivl/sizer-s.conf
file path=usr/lib/$(MACH64)/ivl/sizer.conf
file path=usr/lib/$(MACH64)/ivl/sizer.tgt
file path=usr/lib/$(MACH64)/ivl/stub-s.conf
file path=usr/lib/$(MACH64)/ivl/stub.conf
file path=usr/lib/$(MACH64)/ivl/stub.tgt
file path=usr/lib/$(MACH64)/ivl/system.vpi
file path=usr/lib/$(MACH64)/ivl/v2005_math.vpi
file path=usr/lib/$(MACH64)/ivl/v2009.vpi
file path=usr/lib/$(MACH64)/ivl/va_math.vpi
file path=usr/lib/$(MACH64)/ivl/vhdl-s.conf
