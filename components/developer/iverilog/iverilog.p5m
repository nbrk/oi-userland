file path=usr/lib/$(MACH64)/ivl/blif.tgt
file path=usr/lib/$(MACH64)/ivl/cadpli.vpl
file path=usr/lib/$(MACH64)/ivl/include/constants.vams
file path=usr/lib/$(MACH64)/ivl/include/disciplines.vams
file path=usr/lib/$(MACH64)/ivl/ivl
